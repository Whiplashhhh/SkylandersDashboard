# Configuration du lanceur de session (tools/skylanders-session.sh).
# Copier vers ~/.config/skylanders/session.env et adapter.

# Cemu patche. Par defaut : <dossier parent du dashboard>/Cemu/bin/Cemu_release
#CEMU_BIN="$HOME/projects/CemuSkylandersVersion/Cemu/bin/Cemu_release"

# Jeu lance automatiquement. Vide = Cemu ouvre sa liste de jeux.
GAME_PATH="$HOME/Games/Cemu/Skylanders - Trap Team (Europe) (En,Fr,De,Es,It,Nl,Sv,No,Da,Fi).wux"

# Configurations de l'agent et du connecteur.
#AGENT_CONFIG="$HOME/.config/skylanders/agent.yaml"
#CONNECTOR_CONFIG="$HOME/.config/skylanders/connector.json"

# Ouvrir le dashboard dans le navigateur au demarrage (1 = oui, 0 = non).
OPEN_DASHBOARD=1
