# Configuration du deploiement serveur. Copier en .env a cote du docker-compose
# et remplir. Ce fichier est ignore par git ; .env aussi.
#
# Generer chaque jeton : openssl rand -hex 32

# Base de donnees
POSTGRES_DB=skylanders
POSTGRES_USER=skylanders
POSTGRES_PASSWORD=

# Jetons applicatifs. Trois roles distincts, ne pas reutiliser la meme valeur :
#  - INGEST_TOKEN           : agent d'ingestion (laptop) -> /api/ingest
#  - PORTAL_CONNECTOR_TOKEN : connecteur Cemu (laptop)   -> /api/bridge/exchange
#  - PORTAL_CONTROL_TOKEN   : navigateur (page portail)  -> commandes du portail
INGEST_TOKEN=
PORTAL_CONNECTOR_TOKEN=
PORTAL_CONTROL_TOKEN=

# Publication du port. Adresse Tailscale du serveur recommandee ; 0.0.0.0 ouvre au LAN.
SERVER_BIND=127.0.0.1
SERVER_PORT=8080

# Dossier des visuels sur le serveur (copyright Activision, hors depot et hors image).
IMAGES_HOST_DIR=./images

# Emplacements du portail affiches dans la grille (la serrure a piege est en plus).
PORTAL_SLOTS=9
